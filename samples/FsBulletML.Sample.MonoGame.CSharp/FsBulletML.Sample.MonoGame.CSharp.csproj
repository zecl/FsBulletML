<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsBulletML.Sample.MonoGame.CSharp</RootNamespace>
    <AssemblyName>FsBulletML.Sample.MonoGame.CSharp</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Background.cs" />
    <Compile Include="BulletFunctions.cs" />
    <Compile Include="Enemy.cs" />
    <Compile Include="EnemyControl.cs" />
    <Compile Include="Fps.cs" />
    <Compile Include="FsBulletMLSampleGame.cs" />
    <Compile Include="IEnemy.cs" />
    <Compile Include="Particle.cs" />
    <Compile Include="ParticleEmitter.cs" />
    <Compile Include="Player.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML.Core\FsBulletML.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML.MonoGame\FsBulletML.MonoGame.fsproj" />
    <ProjectReference Include="..\FsBulletML.Bullets\FsBulletML.Bullets.fsproj" />
    <ProjectReference Include="..\FsBulletML.Sample.MonoGame.Font\FsBulletML.Sample.MonoGame.Font.csproj" />
  </ItemGroup>
</Project>
